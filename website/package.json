{
  "name": "vexlor-website",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Pages website and telemetry API for Vexlor Control Center",
  "scripts": {
    "dev": "wrangler pages dev public --port 4173",
    "deploy": "wrangler pages deploy public --project-name=infos-vcc",
    "db:migrate:local": "wrangler d1 migrations apply vcc-telemetry --local",
    "db:migrate:remote": "wrangler d1 migrations apply vcc-telemetry --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
